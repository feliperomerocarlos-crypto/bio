# Solo plantilla. Configurar valores reales en Netlify; nunca publicarlos en GitHub.
DB_HOST=
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=
GEMINI_API_KEY=
# MÍNIMO OBLIGATORIO: 32 caracteres. Recomendado: 64 aleatorios de un gestor.
TICKET_TOKEN_SECRET=
AYUDA_PIN=
# Opcionales: no cambiar los modelos autorizados.
# GEMINI_MODEL_AGENTE=gemini-3.5-flash-lite
# GEMINI_SEARCH_MODEL=gemini-3.5-flash-lite
# Recuperación por correo: estos cuatro valores son obligatorios para habilitarla.
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SUPPORT_FROM=
# 465 usa TLS directo; 587 exige STARTTLS. TLS no se desactiva.
SMTP_PORT=465
